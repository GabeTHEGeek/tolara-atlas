# Voice copilot model provider. The agent speaks one OpenAI-shaped
# /chat/completions API, so switching provider is this one line plus the
# matching key -- no code changes.
#
#   gemini   - free tier via Google AI Studio (default; start here)
#   deepseek - very cheap, OpenAI-compatible
#   openai   - paid, best tool-calling
#   openrouter - free: nvidia/nemotron-3.5-lightning:free, tool calling
#                supported, no token cost. Check your OpenRouter privacy
#                settings — free models can require prompt logging.
#   nvidia   - NVIDIA NIM; Nemotron 3.5 Lightning. Fast model, but the free
#              endpoint hangs on roughly one call in three.
#   opencode - OpenCode Zen gateway: one key, many models (gpt-5.x,
#              claude-*, gemini-3.x, deepseek-v4-*, qwen3.x, glm-5.x).
#              Needs account credit; its *-free models are locked to the
#              OpenCode client and return 403 from here.
TOLARA_AGENT_PROVIDER=gemini

GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=

# Optional: override the default model for the chosen provider.
# Defaults: gemini-3.6-flash / deepseek-flash (V4.1) / gpt-4.1-mini /
# deepseek-v4.1-flash (opencode) / nvidia/nemotron-3.5-lightning:free.
# TOLARA_AGENT_MODEL=

# Voice transport. 'webspeech' uses the browser's built-in speech recognition
# and synthesis: free, no audio leaves the machine until the transcript is
# sent to /api/agent. 'realtime' switches to OpenAI speech-to-speech over
# WebRTC — barge-in, a real voice, and a true output waveform, billed per
# minute of audio. Requires OPENAI_API_KEY.
TOLARA_VOICE_TRANSPORT=webspeech
# TOLARA_REALTIME_MODEL=gpt-realtime-2.1-mini

# Turn detection for the realtime transport. 'server' answers as soon as you
# stop speaking; 'semantic' waits to judge whether you finished a thought —
# kinder to rambling speech, noticeably slower on short questions.
# TOLARA_VAD=server

# Point the agent at a gateway or a self-hosted OpenAI-compatible server.
# TOLARA_AGENT_BASE_URL=
